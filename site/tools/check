#!/usr/bin/env python3
"""Check every quotation on the page against the thing it quotes.

The page quotes the source and the program. Every quote is a copy, and copies
rot, so each <pre data-from> in index.html names where it came from — a file,
or a command — and every line of it must be found there, character for
character. Run from anywhere; the page is not published unless this passes.
"""
import html
import pathlib
import re
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parents[2]
page = (root / 'site' / 'index.html').read_text()
subprocess.run(['make'], cwd=root, check=True, capture_output=True)


def original(where):
    if where.startswith('./'):
        run = subprocess.run(where.split(), cwd=root, check=True,
                             capture_output=True, text=True)
        return re.sub(r'\033\[[0-9;]*m', '', run.stdout)
    return (root / where).read_text()


quotes = re.findall(r'<pre[^>]*data-from="([^"]+)"[^>]*>(.*?)</pre>', page, re.S)
if not quotes:
    sys.exit('no quotations found in index.html — the anchor has moved')

wrong = 0
for where, body in quotes:
    there = {line.rstrip() for line in original(where).splitlines()}
    lines = html.unescape(re.sub(r'<[^>]+>', '', body)).splitlines()
    for line in filter(str.strip, lines):
        if line.rstrip() not in there:
            print(f'  not in {where}:\n    {line}')
            wrong += 1
    print(f'  {where:32s} {len(lines):3d} lines')

# The phases under the player are the script in apps/record.cpp.
script = (root / 'apps' / 'record.cpp').read_text()
phases = re.findall(r'data-seconds="([^"]+)">([^<]+)<', page)
if not phases:
    sys.exit('no phases found in index.html — the anchor has moved')
for seconds, what in phases:
    if not re.search(rf'"{what}",\s+{re.escape(seconds)},.*true', script):
        print(f'  not in apps/record.cpp: {what} for {seconds} s, recorded')
        wrong += 1
print(f'  {"apps/record.cpp":32s} {len(phases):3d} phases')

sys.exit(f'{wrong} lines on the page are no longer true' if wrong else 0)
